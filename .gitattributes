# Normalise line endings across platforms: store text as LF in the repo.
* text=auto eol=lf

# Windows PowerShell scripts keep CRLF locally.
*.ps1 text eol=crlf

# Treat these as binary (no line-ending conversion).
*.png binary
*.jpg binary
*.svg binary

# Git LFS — the Cérebro knowledge base ships whole books and slide decks; the
# largest is 151 MB, past GitHub's 100 MB limit for an ordinary blob.
# `-text` is required: without it the `* text=auto eol=lf` above would try to
# normalise line endings inside the LFS pointer and corrupt the file.
*.pdf filter=lfs diff=lfs merge=lfs -text
*.pptx filter=lfs diff=lfs merge=lfs -text
