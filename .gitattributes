# Normalise line endings across platforms: store text as LF in the repo.
* text=auto eol=lf

# Windows PowerShell scripts keep CRLF locally.
*.ps1 text eol=crlf

# Treat these as binary (no line-ending conversion).
*.png binary
*.jpg binary
*.svg binary

# Git LFS — material de referência do Cérebro.
# Um PDF de livro passa de 100 MB, teto de um blob comum no GitHub; sem LFS o
# push é recusado. `-text` é obrigatório: sem ele o `* text=auto eol=lf` acima
# tentaria normalizar fim de linha no ponteiro do LFS e corromperia o arquivo.
*.pdf  filter=lfs diff=lfs merge=lfs -text
*.pptx filter=lfs diff=lfs merge=lfs -text
