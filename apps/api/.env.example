# MaterialSelect AI — backend environment (example).
# Copy to .env and adjust. NEVER commit a real .env or any secret.

# Database. SQLite for local dev; switch to PostgreSQL in production, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/materialselect
DATABASE_URL=sqlite:///./materialselect.db

# Comma-separated list of allowed browser origins (the web app).
CORS_ORIGINS=http://localhost:3000

# Environment label.
ENVIRONMENT=development

# --- AI layer (optional, Phase 6 — NOT required to run the MVP) ------------
# Leave empty to run fully deterministically, with no AI provider. An unknown
# name fails loudly instead of falling back: an environment must never believe
# it is talking to a model when it is not.
#
#   AI_PROVIDER=mock        deterministic local rules, no key, no network
#   AI_PROVIDER=claude-cli  Claude Code already installed and signed in here
#   AI_PROVIDER=claude-api  Anthropic Messages API, with your own key
#
# AI_PROVIDER=mock

# Only for claude-api. Prefer leaving this empty and exporting ANTHROPIC_API_KEY
# instead — the SDK reads it directly and the key never touches app settings.
# NEVER commit a real key.
# AI_API_KEY=

# Model for both real providers.
# AI_MODEL=claude-opus-5

# Seconds to wait for one answer. The CLI provider needs the higher end: it
# starts a process before it asks a model.
# AI_TIMEOUT_SECONDS=90

# Ceiling for one answer (thinking and text together).
# AI_MAX_OUTPUT_TOKENS=16000

# Executable for claude-cli, resolved on PATH.
# AI_CLI_COMMAND=claude
