# MaterialSelect AI — backend environment (example).
# Copy to .env and adjust. NEVER commit a real .env or any secret.

# Database. SQLite for local dev; switch to PostgreSQL in production, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/materialselect
DATABASE_URL=sqlite:///./materialselect.db

# Comma-separated list of allowed browser origins (the web app).
CORS_ORIGINS=http://localhost:3000

# Environment label.
ENVIRONMENT=development

# Application name shown in the API metadata.
# APP_NAME=MaterialSelect AI

# --- Import limits ---------------------------------------------------------
# These three bound how much of the machine one upload can take. They are the
# knobs to turn before anything else if the API is exposed to more than one
# person: an import is the only request that reads a whole file into memory and
# then writes thousands of rows.
#
# Where uploaded files wait while an import job is open.
# UPLOAD_DIR=var/uploads
# Hard ceiling on one uploaded file, in bytes. Default 5 MiB.
# MAX_UPLOAD_BYTES=5242880
# Hard ceiling on data rows per import, bounding validation and commit time.
# MAX_IMPORT_ROWS=5000

# --- AI layer (optional, Phase 6 — NOT required to run the MVP) ------------
# Leave empty to run fully deterministically, with no AI provider. An unknown
# name fails loudly instead of falling back: an environment must never believe
# it is talking to a model when it is not.
#
#   AI_PROVIDER=mock          deterministic local rules, no key, no network
#   AI_PROVIDER=claude-cli    Claude Code already installed and signed in here
#   AI_PROVIDER=claude-api    Anthropic Messages API, with your own key
#   AI_PROVIDER=openai-compat any OpenAI-compatible server, chosen by AI_BASE_URL
#
# AI_PROVIDER=mock

# Bearer token for openai-compat; optional override for claude-api (prefer
# leaving it empty there and exporting ANTHROPIC_API_KEY, which the SDK reads
# directly so the key never touches app settings). Empty is a *valid* setting
# for openai-compat: a local server wants no Authorization header at all.
# NEVER commit a real key.
# AI_API_KEY=

# Model. The right value depends on the provider — see the recipes below.
# AI_MODEL=claude-opus-5

# Seconds to wait for one answer. The CLI provider needs the higher end: it
# starts a process before it asks a model.
# AI_TIMEOUT_SECONDS=90

# Ceiling for one answer (thinking and text together).
# AI_MAX_OUTPUT_TOKENS=16000

# Executable for claude-cli, resolved on PATH.
# AI_CLI_COMMAND=claude

# --- openai-compat ---------------------------------------------------------
# Root of an OpenAI-compatible API, ending at /v1. It has no default because a
# default would choose a vendor for you.
#
# Three working recipes, cheapest first:
#
#   1. Ollama on this machine — no account, no key, no internet, no rate limit.
#      The only configuration in this file where authentication cannot fail.
#      Install from ollama.com, then `ollama pull llama3.1`.
#        AI_PROVIDER=openai-compat
#        AI_BASE_URL=http://localhost:11434/v1
#        AI_MODEL=llama3.1
#        AI_JSON_MODE=object
#
#   2. Groq's free plan — a hosted model, sign-up with no credit card, and
#      published limits (30 req/min, 1000 req/day at the time of writing).
#      `openai/gpt-oss-20b` is the free model that honours a strict JSON schema.
#        AI_PROVIDER=openai-compat
#        AI_BASE_URL=https://api.groq.com/openai/v1
#        AI_MODEL=openai/gpt-oss-20b
#        AI_API_KEY=gsk_...
#
#   3. OpenAI, OpenRouter, or any corporate gateway — same shape, paid key.
#        AI_BASE_URL=https://api.openai.com/v1
#
# Note that everything you type into the AI panel is sent to whichever host you
# set here, and free tiers commonly reserve the right to train on it. The
# interface says so next to every suggestion; this is the setting it is
# describing. A local Ollama sends nothing anywhere.
# AI_BASE_URL=

# How the answer's shape is enforced. Degrading is your decision, never a
# silent fallback:
#   schema  response_format=json_schema, strict — a real guarantee (default)
#   object  response_format=json_object — valid JSON, shape asked in words
#   prompt  nothing enforced; the schema travels in the system prompt
# A 400 mentioning response_format means the model does not do `schema`.
# Whatever it answers still passes the guardrails either way.
# AI_JSON_MODE=schema

# --- Auth: login with Google (required to run anything past /health) -------
# Login is Google-only — there is no password anywhere in this system. Empty
# client id/secret means login is off: /auth/google/login answers 503 with a
# clear reason instead of crashing into Google with bad credentials. There is
# no default client id, same reasoning as AI_BASE_URL having none: a default
# would pick whose Google Cloud project logs everyone in.
#
# To get a client id/secret:
#   1. https://console.cloud.google.com/apis/credentials — pick or create a
#      project.
#   2. "Configure consent screen" if you haven't yet. External is fine for a
#      small group; internal if the project has a Google Workspace.
#   3. "+ Create credentials" -> "OAuth client ID" -> Application type
#      "Web application".
#   4. Under "Authorized redirect URIs", add exactly
#      {BACKEND_BASE_URL}/api/auth/google/callback — for local dev that is
#      http://localhost:8000/api/auth/google/callback. It has to match
#      byte-for-byte, including the scheme and the trailing path.
#   5. Copy the generated client ID and client secret below. NEVER commit a
#      real one.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Empty allows any Google account to log in. Set to restrict logins to one
# email domain (e.g. a university) before hosting for a class.
# GOOGLE_ALLOWED_DOMAIN=

# Used to build the exact redirect_uri Google requires pre-registered above.
# Must match an "Authorized redirect URI" on the OAuth client, with
# /api/auth/google/callback appended.
# BACKEND_BASE_URL=http://localhost:8000

# Where the browser lands after a successful login.
# FRONTEND_URL=http://localhost:3000

# Secure by default: the session cookie is only sent over HTTPS. Local dev
# over plain HTTP must opt out explicitly, so a real deployment can never
# silently forget to turn this on.
# SESSION_COOKIE_SECURE=true

# Session lifetime in hours, fixed at creation — no sliding renewal. Default
# is 336 (14 days).
# SESSION_TTL_HOURS=336

# How long the CSRF `state` cookie survives between the redirect to Google
# and the callback coming back, in seconds.
# OAUTH_STATE_TTL_SECONDS=600

# --- Billing (Stripe) -------------------------------------------------------
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# Sem as três, /billing/* responde 503 — mesmo padrão do Google OAuth.
# Nunca commite uma chave real; use uma chave de teste do Stripe (sk_test_...)
# em desenvolvimento.
