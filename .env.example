# MaterialSelect AI — root environment example.
# Copy the per-app examples instead when running locally:
#   apps/api/.env.example      -> apps/api/.env
#   apps/web/.env.local.example -> apps/web/.env.local
#
# This file documents the full set of variables in one place. NEVER commit real
# secrets or a populated .env.

# --- Backend (apps/api) ---------------------------------------------------
DATABASE_URL=sqlite:///./materialselect.db
# D-227: `null` (default, no idle connection) or `queue` (pool of 5 + 5). Server databases only.
# DB_POOL_MODE=null
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# --- Superfície pública (D-223) --------------------------------------------
# /docs, /redoc e /openapi.json: vazio = ligados fora de ENVIRONMENT=production
# e desligados em produção; true/false força.
# API_DOCS_ENABLED=
# Limite por minuto, em memória, por sessão (ou por IP sem sessão). 429 com
# Retry-After quando estoura. 0 desliga um balde; false desliga todos.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH_PER_MINUTE=20
# RATE_LIMIT_AI_PER_MINUTE=30
# RATE_LIMIT_EXPORTS_PER_MINUTE=30
# RATE_LIMIT_NOTEBOOKS_PER_MINUTE=60
# Quanto tempo o navegador pode reusar as listas estáticas (propriedades,
# classes, processos, glossário, padrões) antes de revalidar com ETag.
# STATIC_LIST_MAX_AGE_SECONDS=300

# --- Frontend (apps/web) --------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- AI layer (optional) ---------------------------------------------------
# "" desliga a camada por completo; "mock" usa o provedor simulado
# determinístico, que não exige chave nem rede. Um nome desconhecido falha alto,
# em vez de cair no simulado. O sistema funciona integralmente sem esta camada.
AI_PROVIDER=mock
# Reservadas para um provedor externo; não são usadas pelo simulado.
# AI_API_KEY=
# AI_MODEL=
# AI_TIMEOUT_SECONDS=90
# Assistente de projeto (/ai/plan, D-224): chamada mais curta e reuso do
# mesmo pedido sem gastar cota. Detalhes em apps/api/.env.example.
# AI_PLAN_TIMEOUT_SECONDS=30
# AI_PLAN_MAX_OUTPUT_TOKENS=6000
# AI_PLAN_MAX_RETRIES=1
# AI_PLAN_CACHE_SECONDS=600
# AI_CONTEXT_CACHE_SECONDS=60

# --- Busca semântica no Cérebro (opcional) ---------------------------------
# Sem isto a busca é só léxica. Receita do Gemini gratuito (D-93, D-101); a
# lista completa e o porquê de cada variável estão em apps/api/.env.example.
# Espera máxima pelo embedding da consulta; passou, segue só a léxica (D-224).
# KNOWLEDGE_RETRIEVAL_BUDGET_SECONDS=2
# KNOWLEDGE_EMBEDDING_MODEL=gemini-embedding-001
# KNOWLEDGE_EMBEDDING_DIMENSIONS=768
