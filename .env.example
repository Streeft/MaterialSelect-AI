# MaterialSelect AI — root environment example.
# Copy the per-app examples instead when running locally:
#   apps/api/.env.example      -> apps/api/.env
#   apps/web/.env.local.example -> apps/web/.env.local
#
# This file documents the full set of variables in one place. NEVER commit real
# secrets or a populated .env.

# --- Backend (apps/api) ---------------------------------------------------
DATABASE_URL=sqlite:///./materialselect.db
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# --- Frontend (apps/web) --------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- AI layer (optional) ---------------------------------------------------
# "" desliga a camada por completo; "mock" usa o provedor simulado
# determinístico, que não exige chave nem rede. Um nome desconhecido falha alto,
# em vez de cair no simulado. O sistema funciona integralmente sem esta camada.
AI_PROVIDER=mock
# Reservadas para um provedor externo futuro; não são usadas pelo simulado.
# AI_API_KEY=
# AI_MODEL=
# AI_TIMEOUT_SECONDS=20
