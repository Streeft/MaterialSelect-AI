{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "apps/web"],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "apps/api/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-c",
        "import os, uvicorn; os.chdir('apps/api'); uvicorn.run('app.main:app', port=8000)"
      ],
      "port": 8000
    }
  ]
}
